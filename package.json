  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2",
    "@earendil-works/pi-ai": ">=1.2.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
